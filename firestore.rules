rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Validates that the requesting caller is authenticated and owns the document path
    function isAuthenticatedOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper: Enforces sanity size check on write operations (deletions or documents with <= 50 keys)
    // to defend against malformed key-flooding attacks.
    function isValidWriteSize() {
      return request.resource == null || request.resource.data.keys().size() <= 50;
    }

    // 1. Datos del usuario (documento de usuario y todas sus subcolecciones: recipes, ingredients, units, groups, sync_meta)
    match /users/{userId} {
      allow read: if isAuthenticatedOwner(userId);
      allow write: if isAuthenticatedOwner(userId) && isValidWriteSize();

      match /{allChildren=**} {
        allow read: if isAuthenticatedOwner(userId);
        allow write: if isAuthenticatedOwner(userId) && isValidWriteSize();
      }
    }

    // 2. Suscripciones / Entitlements:
    // El usuario solo puede LEER su propio documento (por UID o email).
    // La ESCRITURA queda completamente bloqueada (solo modificable desde Firebase Console o Admin SDK).
    match /entitlements/{entitlementId} {
      allow read: if request.auth != null && (
        request.auth.uid == entitlementId ||
        ('email' in request.auth.token &&
         request.auth.token.email != null &&
         request.auth.token.email.lower() == entitlementId.lower())
      );
      allow write: if false;
    }
  }
}
