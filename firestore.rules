rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Datos del usuario (documento de usuario y todas sus subcolecciones: recipes, ingredients, units, groups, sync_meta)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allChildren=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 2. Suscripciones / Entitlements:
    // El usuario solo puede LEER su propio documento (por UID o email).
    // La ESCRITURA queda completamente bloqueada (solo modificable desde Firebase Console o Admin SDK).
    match /entitlements/{entitlementId} {
      allow read: if request.auth != null && (
        request.auth.uid == entitlementId ||
        ('email' in request.auth.token &&
         request.auth.token.email != null &&
         request.auth.token.email.lower() == entitlementId.lower())
      );
      allow write: if false;
    }
  }
}
